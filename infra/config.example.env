NAME_PREFIX=understudy
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
GITHUB_REPO=your-org/understudy-deploy
DEPLOY_BRANCHES="main"

PUBLIC_HOST=understudy.example.com
CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000
ALB_GROUP=understudy
NODE_ARCH=arm64
ALLOWED_EMAIL_DOMAIN=example.com
ADMIN_EMAILS=admin@example.com

VPC_CIDR=10.0.0.0/16
SUBNET_CIDR=10.0.0.0/20
SUBNET_AZ=us-east-1a
HOST_INSTANCE_TYPE=m6i.xlarge
HOST_VOLUME_GB=150

EKS_CLUSTER=my-eks-cluster
EKS_VPC_ID=vpc-00000000000000000
EKS_NODE_SG=sg-00000000000000000
DB_SUBNET_IDS="subnet-00000000000000000 subnet-11111111111111111"
DB_INSTANCE_CLASS=db.t4g.micro

EKS_DEPLOY_ROLE_ARN=arn:aws:iam::123456789012:role/my-eks-write-role

DB_IDENTIFIER=
DB_NAME=
DB_USER=
DB_SUBNET_GROUP=
DB_SECURITY_GROUP=
TIMEZONE=UTC
DEPLOY_K8S_GROUP=my-eks-write-group
INGRESS_SOURCE_CIDRS="10.0.1.0/24 10.0.2.0/24"
DB_CIDRS="10.0.31.0/24 10.0.32.0/24"
EXTRA_BLOCKED_CIDRS=
HOST_ID=understudy-host-1
HOST_IDS=
BLOCKED_CIDRS=
INBOUND_EMAIL_DOMAIN=in.bot.example.com
INBOUND_EMAIL_RETENTION_DAYS=30
CLOUDFLARE_ZONE_NAME=
WEB_ROLE_ARN=
